<Window x:Class="AppleTvControlLibrary.Remote.Mrp.Wpf.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:converters="clr-namespace:AppleTvControlLibrary.Remote.Mrp.Wpf.Converters"
		Title="MRP Remote" Height="800" Width="360"
		Background="#FF1B1B1B"
		ResizeMode="CanMinimize">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<converters:NullToVisibilityConverter x:Key="NullToVisibility" />
		<!-- A dark, circular Siri-Remote-style button: filled circle with a centered symbol. -->
		<Style x:Key="RemoteCircleButton" TargetType="Button">
			<Setter Property="Width" Value="64" />
			<Setter Property="Height" Value="64" />
			<Setter Property="Background" Value="#FF2C2C2E" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
											  Content="{TemplateBinding Content}"
											  TextElement.Foreground="{TemplateBinding Foreground}"
											  TextElement.FontSize="{TemplateBinding FontSize}" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Circle" Property="Fill" Value="#FF3A3A3C" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Circle" Property="Fill" Value="#FF444446" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Discovery -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<Button Content="Scan" Command="{Binding ScanCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Pair" Command="{Binding PairCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Connect" Command="{Binding ConnectCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="8,2" />
		</StackPanel>

		<ListBox Grid.Row="1" Height="90" Margin="0,0,0,8"
				 ItemsSource="{Binding Devices}"
				 SelectedItem="{Binding SelectedDevice}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding DisplayName}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="Red" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsPaired}" Value="True">
										<Setter Property="Foreground" Value="Green" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<CheckBox Grid.Row="2" Content="Auto-connect to this device on startup"
				  IsChecked="{Binding AutoConnectSelected}"
				  Margin="0,0,0,8" Foreground="#FFCCCCCC" />

		<TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FFCCCCCC" />

		<!-- Now playing / artwork -->
		<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
			<Border Height="128" MinWidth="64" MaxWidth="128" Background="#FF2C2C2E" CornerRadius="4" Margin="0,0,10,0"
					HorizontalAlignment="Left" VerticalAlignment="Top">
				<Image Source="{Binding Artwork}" Stretch="Uniform" Height="128" MaxWidth="128" />
			</Border>
			<StackPanel VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
					<Border Width="32" Height="32" Margin="0,0,6,0">
						<Image Source="{Binding AppIcon}" Stretch="Uniform" MaxWidth="32" MaxHeight="32" />
					</Border>
					<TextBlock Text="{Binding CurrentAppName}" Foreground="White" FontSize="16" FontWeight="Bold"
							TextWrapping="Wrap" MaxWidth="230" VerticalAlignment="Center" />
				</StackPanel>
				<TextBlock Text="{Binding NowPlayingTitle}" Foreground="White" FontSize="14" FontWeight="SemiBold"
						TextWrapping="Wrap" MaxWidth="230" />
				<TextBlock Text="{Binding NowPlayingSubtitle}" Foreground="#FFAAAAAA" FontSize="12"
						TextWrapping="Wrap" MaxWidth="230" Margin="0,2,0,0" />
				<TextBlock Text="{Binding NowPlayingTimeline}" Foreground="#FF888888" FontSize="11"
						TextWrapping="Wrap" MaxWidth="230" Margin="0,2,0,0" />
			</StackPanel>
		</StackPanel>

		<!-- Siri Remote-style body -->
		<Border Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center"
				Width="220" CornerRadius="42" Padding="0,20,0,20"
				Background="#FFD9D9DE" BorderBrush="#FFB5B5BA" BorderThickness="1">
			<StackPanel>
				<!-- Directional pad + select -->
				<Grid Width="176" Height="176" HorizontalAlignment="Center" Margin="0,0,0,20">
					<!-- Circular clickpad surface, matching the Companion remote's dark touch surface look. -->
					<Ellipse Fill="#FF1C1C1E" Stroke="#FF0A0A0A" StrokeThickness="1" />
					<Button Content="&#9650;" Command="{Binding UpButton}" Style="{StaticResource RemoteCircleButton}"
							Width="44" Height="44" Background="Transparent" FontSize="16"
							VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
							ToolTip="Up" />
					<Button Content="&#9660;" Command="{Binding DownButton}" Style="{StaticResource RemoteCircleButton}"
							Width="44" Height="44" Background="Transparent" FontSize="16"
							VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"
							ToolTip="Down" />
					<Button Content="&#9664;" Command="{Binding LeftButton}" Style="{StaticResource RemoteCircleButton}"
							Width="44" Height="44" Background="Transparent" FontSize="16"
							VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
							ToolTip="Left" />
					<Button Content="&#9654;" Command="{Binding RightButton}" Style="{StaticResource RemoteCircleButton}"
							Width="44" Height="44" Background="Transparent" FontSize="16"
							VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
							ToolTip="Right" />
					<Button Content="&#9673;" Command="{Binding SelectButton}" Style="{StaticResource RemoteCircleButton}"
							Width="56" Height="56" Background="Transparent" FontSize="18"
							VerticalAlignment="Center" HorizontalAlignment="Center"
							ToolTip="Select" />
				</Grid>

				<!-- Menu (back) / Home -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
					<Button Content="&#8249;" Command="{Binding MenuButton}" Style="{StaticResource RemoteCircleButton}"
							Margin="0,0,12,0" ToolTip="Menu (Back)" />
					<Button Content="&#128250;" Command="{Binding HomeButton}" Style="{StaticResource RemoteCircleButton}"
							FontSize="18" ToolTip="Home" />
				</StackPanel>

				<!-- Play/Pause / Volume -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
					<Button Content="&#9199;" Command="{Binding PlayPauseButton}"
							FontSize="18" Margin="0,0,20,0" ToolTip="Play/Pause">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource RemoteCircleButton}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsPlaying}" Value="True">
										<Setter Property="Background" Value="#FF2E7D32" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
					<StackPanel Visibility="{Binding IsVolumeControlAvailable, Converter={StaticResource BoolToVisibility}}">
						<Button Content="+" Command="{Binding VolumeUpButton}" Style="{StaticResource RemoteCircleButton}"
								Width="64" Height="30" FontSize="16" Margin="0,0,0,4" ToolTip="Volume Up" />
						<Button Content="&#8722;" Command="{Binding VolumeDownButton}" Style="{StaticResource RemoteCircleButton}"
								Width="64" Height="30" FontSize="16" ToolTip="Volume Down" />
					</StackPanel>
				</StackPanel>

				<!-- Playback transport: rewind / skip back / skip forward / fast-forward -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Button Content="&#9198;" Command="{Binding RewindButton}"
							Width="42" Height="42" FontSize="16" Margin="0,0,6,0" ToolTip="Rewind">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource RemoteCircleButton}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSeeking}" Value="True">
										<Setter Property="Background" Value="#FF2E7D32" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
					<Button Content="&#9194;" Command="{Binding SkipBackwardButton}" Style="{StaticResource RemoteCircleButton}"
							Width="42" Height="42" FontSize="16" Margin="0,0,6,0" ToolTip="Skip Backward" />
					<Button Content="&#9193;" Command="{Binding SkipForwardButton}" Style="{StaticResource RemoteCircleButton}"
							Width="42" Height="42" FontSize="16" Margin="0,0,6,0" ToolTip="Skip Forward" />
					<Button Content="&#9197;" Command="{Binding FastForwardButton}"
							Width="42" Height="42" FontSize="16" ToolTip="Fast Forward">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource RemoteCircleButton}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSeeking}" Value="True">
										<Setter Property="Background" Value="#FF2E7D32" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>
