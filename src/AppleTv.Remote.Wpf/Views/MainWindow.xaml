<Window x:Class="AppleTvControlLibrary.Remote.Wpf.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Apple TV Remote" Height="600" Width="360"
		ResizeMode="CanMinimize">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Discovery -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<Button Content="Scan" Command="{Binding ScanCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Pair" Command="{Binding PairCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Connect" Command="{Binding ConnectCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="8,2" />
		</StackPanel>

		<ListBox Grid.Row="1" Height="90" Margin="0,0,0,8"
				 ItemsSource="{Binding Devices}"
				 SelectedItem="{Binding SelectedDevice}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding DisplayName}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="Red" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsPaired}" Value="True">
										<Setter Property="Foreground" Value="Green" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap" />

		<!-- Remote control button grid -->
		<Grid Grid.Row="3" VerticalAlignment="Center">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Button Grid.Row="0" Grid.Column="1" Content="Menu" Margin="4" Padding="8" Command="{Binding MenuButton}" />

			<Button Grid.Row="1" Grid.Column="1" Content="▲" Margin="4" Padding="8" Command="{Binding UpButton}" />
			<Button Grid.Row="2" Grid.Column="0" Content="◀" Margin="4" Padding="8" Command="{Binding LeftButton}" />
			<Button Grid.Row="2" Grid.Column="1" Content="OK" Margin="4" Padding="8" Command="{Binding SelectButton}" />
			<Button Grid.Row="2" Grid.Column="2" Content="▶" Margin="4" Padding="8" Command="{Binding RightButton}" />
			<Button Grid.Row="3" Grid.Column="1" Content="▼" Margin="4" Padding="8" Command="{Binding DownButton}" />

			<Button Grid.Row="4" Grid.Column="0" Content="Home" Margin="4" Padding="8" Command="{Binding HomeButton}" />
			<Button Grid.Row="4" Grid.Column="1" Content="Play/Pause" Margin="4" Padding="8" Command="{Binding PlayPauseButton}" />
			<Button Grid.Row="4" Grid.Column="2" Content="Siri" Margin="4" Padding="8" Command="{Binding SiriButton}" />
		</Grid>

		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
			<Button Content="Vol -" Command="{Binding VolumeDownButton}" Padding="12,4" Margin="0,0,8,0" />
			<Button Content="Vol +" Command="{Binding VolumeUpButton}" Padding="12,4" Margin="0,0,8,0" />
			<Button Command="{Binding MuteButton}" Padding="12,4"
					ToolTip="Mute/unmute using Companion's media-control volume commands (requires the app to advertise volume support).">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Content" Value="Mute" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsMuted}" Value="True">
								<Setter Property="Content" Value="Unmute" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</StackPanel>
	</Grid>
</Window>
