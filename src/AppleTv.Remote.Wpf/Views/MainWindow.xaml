<Window x:Class="AppleTvControlLibrary.Remote.Wpf.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Apple TV Remote" Height="780" Width="360"
		Background="#FF1B1B1B"
		ResizeMode="CanMinimize">
	<Window.Resources>
		<!-- A dark, circular Siri-Remote-style button: filled circle with a centered symbol. -->
		<Style x:Key="RemoteCircleButton" TargetType="Button">
			<Setter Property="Width" Value="64" />
			<Setter Property="Height" Value="64" />
			<Setter Property="Background" Value="#FF2C2C2E" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
											  Content="{TemplateBinding Content}"
											  TextElement.Foreground="{TemplateBinding Foreground}"
											  TextElement.FontSize="{TemplateBinding FontSize}" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Circle" Property="Fill" Value="#FF3A3A3C" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Circle" Property="Fill" Value="#FF444446" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Power button: same circular chrome at half size, glows red (asleep) / green (awake) once known. -->
		<Style x:Key="PowerCircleButton" TargetType="Button" BasedOn="{StaticResource RemoteCircleButton}">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Content" Value="&#9211;" />
			<Setter Property="Background" Value="#FFB5B5BA" />
			<Setter Property="Foreground" Value="#FF6E6E72" />
			<Setter Property="FontSize" Value="14" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsPowerStateKnown}" Value="True">
					<Setter Property="Background" Value="#FFB5B5BA" />
					<Setter Property="Foreground" Value="#FFD70015" />
				</DataTrigger>
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsPowerStateKnown}" Value="True" />
						<Condition Binding="{Binding IsAwake}" Value="True" />
					</MultiDataTrigger.Conditions>
					<Setter Property="Foreground" Value="#FF248A3D" />
				</MultiDataTrigger>
			</Style.Triggers>
		</Style>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Discovery -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<Button Content="Scan" Command="{Binding ScanCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Pair" Command="{Binding PairCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Connect" Command="{Binding ConnectCommand}" Padding="8,2" Margin="0,0,8,0" />
			<Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="8,2" />
		</StackPanel>

		<ListBox Grid.Row="1" Height="90" Margin="0,0,0,8"
				 ItemsSource="{Binding Devices}"
				 SelectedItem="{Binding SelectedDevice}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding DisplayName}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="Red" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsPaired}" Value="True">
										<Setter Property="Foreground" Value="Green" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<CheckBox Grid.Row="2" Content="Auto-connect to this device on startup"
				  IsChecked="{Binding AutoConnectSelected}"
				  Margin="0,0,0,8" Foreground="#FFCCCCCC" />

		<TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FFCCCCCC" />

		<!-- App / Account selectors: only shown when the connected device supports the feature. -->
		<StackPanel Grid.Row="4" Margin="0,0,0,8">
			<ComboBox Visibility="{Binding IsAppListSupported, Converter={StaticResource BoolToVis}}"
					  ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
					  DisplayMemberPath="DisplayName" Margin="0,0,0,4"
					  ToolTip="Launch an app (Companion _launchApp)." />
			<ComboBox Visibility="{Binding IsAccountListSupported, Converter={StaticResource BoolToVis}}"
					  ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
					  DisplayMemberPath="DisplayName"
					  ToolTip="Switch user account (Companion SwitchUserAccountEvent). The device does not report which account is active, so this starts unselected and then shows whichever account was most recently switched to." />
			<TextBlock Text="Current account: unknown (device does not report it)"
						FontStyle="Italic" Foreground="#FF8A8A8E" Margin="0,2,0,0">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsAccountListSupported}" Value="True" />
									<Condition Binding="{Binding IsCurrentAccountKnown}" Value="False" />
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility" Value="Visible" />
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</StackPanel>

		<!-- Siri Remote-style body -->
		<Border Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center"
				Width="220" CornerRadius="42" Padding="0,20,0,20"
				Background="#FFD9D9DE" BorderBrush="#FFB5B5BA" BorderThickness="1">
			<Grid>
				<StackPanel>
					<!-- Microphone dot -->
					<Ellipse Width="6" Height="6" Fill="#FF8A8A8E" HorizontalAlignment="Center" Margin="0,0,0,16"
							  ToolTip="Microphone for Siri" />

					<!-- Clickpad + Siri side button -->
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0" Width="176" Height="176" HorizontalAlignment="Center">
							<!-- Touchpad: drag simulates a Companion touch surface swipe, click simulates a tap/select. -->
							<Ellipse x:Name="TouchpadSurface" Fill="#FF1C1C1E" Stroke="#FF0A0A0A" StrokeThickness="1"
									 ToolTip="Drag to swipe, click to select (Companion touch surface)."
									 MouseDown="TouchpadSurface_MouseDown" MouseMove="TouchpadSurface_MouseMove"
									 MouseUp="TouchpadSurface_MouseUp" MouseLeave="TouchpadSurface_MouseLeave" />

							<Button Content="&#9650;" Command="{Binding UpButton}" Style="{StaticResource RemoteCircleButton}"
									Width="44" Height="44" Background="Transparent" FontSize="16"
									VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
									ToolTip="Up" IsHitTestVisible="True" />
							<Button Content="&#9660;" Command="{Binding DownButton}" Style="{StaticResource RemoteCircleButton}"
									Width="44" Height="44" Background="Transparent" FontSize="16"
									VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"
									ToolTip="Down" />
							<Button Content="&#9664;" Command="{Binding LeftButton}" Style="{StaticResource RemoteCircleButton}"
									Width="44" Height="44" Background="Transparent" FontSize="16"
									VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
									ToolTip="Left" />
							<Button Content="&#9654;" Command="{Binding RightButton}" Style="{StaticResource RemoteCircleButton}"
									Width="44" Height="44" Background="Transparent" FontSize="16"
									VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
									ToolTip="Right" />
							<Button Content="&#9673;" Command="{Binding SelectButton}" Style="{StaticResource RemoteCircleButton}"
									Width="56" Height="56" Background="Transparent" FontSize="18"
									VerticalAlignment="Center" HorizontalAlignment="Center"
									ToolTip="Select" />
						</Grid>

						<Button Grid.Column="1" Content="&#128172;" Command="{Binding SiriButton}" Style="{StaticResource RemoteCircleButton}"
								Width="24" Height="52" Background="#FFB5B5BA" Foreground="#FF3A3A3C" FontSize="12"
								VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Siri" />
					</Grid>

					<!-- Back / TV-Home -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
						<Button Content="&#8249;" Command="{Binding MenuButton}" Style="{StaticResource RemoteCircleButton}"
								Margin="0,0,20,0" ToolTip="Back" />
						<Button Content="&#128250;" Command="{Binding HomeButton}" Style="{StaticResource RemoteCircleButton}"
								FontSize="18" ToolTip="TV/Home" />
					</StackPanel>

					<!-- Play/Pause / Volume -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
						<Button Content="&#9199;" Command="{Binding PlayPauseButton}" Style="{StaticResource RemoteCircleButton}"
								FontSize="18" Margin="0,0,20,0" ToolTip="Play/Pause" />
						<StackPanel>
							<Button Content="+" Command="{Binding VolumeUpButton}" Style="{StaticResource RemoteCircleButton}"
									Width="64" Height="30" FontSize="16" Margin="0,0,0,4" ToolTip="Volume Up" />
							<Button Content="&#8722;" Command="{Binding VolumeDownButton}" Style="{StaticResource RemoteCircleButton}"
									Width="64" Height="30" FontSize="16" ToolTip="Volume Down" />
						</StackPanel>
					</StackPanel>

					<!-- Mute -->
					<Button Content="&#128264;" Command="{Binding MuteButton}" Style="{StaticResource RemoteCircleButton}"
							FontSize="18" HorizontalAlignment="Center"
							ToolTip="Mute/unmute using Companion's media-control volume commands (requires the app to advertise volume support)." />
				</StackPanel>

				<!-- Power: upper-right corner of the remote body, half the size of the other round buttons. -->
				<Button Command="{Binding PowerButton}" Style="{StaticResource PowerCircleButton}"
						HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0"
						ToolTip="Sleep/wake the device (Companion HID Sleep/Wake). Current state is fetched once via FetchAttentionState at connect, then kept up to date from pushed SystemStatus/TVSystemStatus events." />
			</Grid>
		</Border>
	</Grid>
</Window>
