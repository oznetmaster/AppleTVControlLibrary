<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<PackageId>AppleTvControlLibrary.All</PackageId>
		<Version>1.0.0</Version>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>appletv;companion-link;discovery;mdns;api;library</PackageTags>
		<RepositoryUrl>https://github.com/oznetmaster/AppleTVControlLibrary</RepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/AppleTVControlLibrary</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Convenience package that installs both AppleTvControlLibrary Companion Link protocol support and AppleTvControlLibrary.Discovery mDNS discovery support.</Description>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AppleTV.Companion\AppleTV.Companion.csproj" />
		<ProjectReference Include="..\AppleTV.Companion.Discovery\AppleTV.Companion.Discovery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\..\ATTRIBUTIONS.md" Pack="true" PackagePath="" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
