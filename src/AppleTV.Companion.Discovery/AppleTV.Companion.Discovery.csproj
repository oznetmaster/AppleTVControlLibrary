<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>AppleTvControlLibrary.Discovery</RootNamespace>
		<AssemblyName>AppleTvControlLibrary.Discovery</AssemblyName>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageId>AppleTvControlLibrary.Discovery</PackageId>
		<Version>2.2.3</Version>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>appletv;api;discovery;mdns</PackageTags>
		<RepositoryUrl>https://github.com/oznetmaster/AppleTVControlLibrary</RepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/AppleTVControlLibrary</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>mDNS/DNS-SD discovery for AppleTvControlLibrary, covering both Companion Link and MRP, isolated behind an interface for host portability.</Description>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.Configuration" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\..\ATTRIBUTIONS.md" Pack="true" PackagePath="" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
