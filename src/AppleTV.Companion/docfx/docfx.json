{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "AppleTV.Companion.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    },
    {
      "src": [
        {
          "src": "../../AppleTV.Companion.Discovery",
          "files": [
            "AppleTV.Companion.Discovery.csproj"
          ]
        }
      ],
      "dest": "discovery-api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/**.md",
          "discovery-api/**.yml",
          "discovery-api/**.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "AppleTvControlLibrary Documentation"
    },
    "template": [
      "default",
      "modern"
    ],
    "markdownEngineName": "markdig",
    "disableGitFeatures": false
  }
}