<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net472</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RunSettingsFilePath>$(MSBuildThisFileDirectory)..\..\.runsettings</RunSettingsFilePath>
		<NoWarn>$(NoWarn);CS0618</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<VSTestUseHost>true</VSTestUseHost>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\AppleTv.Mrp\AppleTv.Mrp.csproj" />
		<ProjectReference Include="..\AppleTv.Mrp.FakeDevice\AppleTv.Mrp.FakeDevice.csproj" />
		<ProjectReference Include="..\..\src\AppleTv.Hap\AppleTv.Hap.csproj" />
	</ItemGroup>

</Project>
